{
  "manifest_version": 3,
  "name": "PolyTrack Autopilot",
  "version": "0.2.1",
  "description": "Experimental tools for inspecting PolyTrack and recording/replaying driving inputs.",
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://kodub.com/*",
    "https://www.kodub.com/*",
    "https://*.itch.zone/*",
    "https://*.itch.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kodub.com/*",
        "https://www.kodub.com/*",
        "https://*.itch.zone/*",
        "https://*.itch.io/*"
      ],
      "js": [
        "src/analysis.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "PolyTrack Autopilot"
  }
}
