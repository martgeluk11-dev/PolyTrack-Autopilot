{
  "manifest_version": 3,
  "name": "PolyTrack Autopilot",
  "version": "0.6.0",
  "description": "Analyze PolyTrack track geometry and plan a 3D practice racing route.",
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://kodub.com/*",
    "https://www.kodub.com/*",
    "https://*.itch.zone/*",
    "https://*.itch.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kodub.com/*",
        "https://www.kodub.com/*",
        "https://*.itch.zone/*",
        "https://*.itch.io/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://kodub.com/*",
        "https://www.kodub.com/*",
        "https://*.itch.zone/*",
        "https://*.itch.io/*"
      ],
      "js": [
        "src/analysis.js",
        "src/track-decoder.js",
        "src/track-planner.js",
        "src/autopilot.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "PolyTrack Autopilot"
  }
}
